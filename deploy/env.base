# ==============================================================================
# Sentry self-hosted — base configuration (VERSION CONTROLLED)
# ==============================================================================
#
# This file holds our NON-SECRET overrides for upstream's .env.
# It is committed to git.
#
#   >>> NEVER PUT A SECRET IN THIS FILE. <<<
#
# deploy/bootstrap.sh copies this into `.env.custom` and appends generated
# secrets there. `.env.custom` is gitignored.
#
# install.sh reads `.env.custom` when it exists, and merges it OVER `.env`
# (see install/_lib.sh). So only the keys we actually change belong here.
# ------------------------------------------------------------------------------

# Event retention. Upstream default is 90 days; we keep 30.
# The `cron` service runs `sentry cleanup --days $SENTRY_EVENT_RETENTION_DAYS`
# nightly, and Snuba/ClickHouse TTLs are derived from this value at bootstrap.
# NOTE: lowering this AFTER the first install does not retroactively shrink
# existing ClickHouse partitions. Set it before the first ./install.sh run.
SENTRY_EVENT_RETENTION_DAYS=30

# Bind the nginx frontend to loopback only. A host-level reverse proxy
# (nginx + TLS for https://sentry.ilmiy.uz) terminates public traffic.
# Upstream default is `9000`, which publishes on 0.0.0.0 — we do not want that.
SENTRY_BIND=127.0.0.1:9000

# Full feature set (errors + performance + profiling + replays + uptime).
# Set to `errors-only` to cut RAM usage roughly in half if the box is tight.
COMPOSE_PROFILES=feature-complete

# Distinct project name keeps `docker compose` scoped to this stack.
COMPOSE_PROJECT_NAME=sentry-self-hosted

# Taskworker parallelism. Upstream default 4. Raise toward the core count
# only if the queue backs up; each worker costs memory.
SENTRY_TASKWORKER_CONCURRENCY=4

# ------------------------------------------------------------------------------
# Deliberately NOT set here — configured later, outside this task:
#   SENTRY_MAIL_HOST   -> SMTP setup
#   STATSD_ADDR        -> metrics collection
# ------------------------------------------------------------------------------
